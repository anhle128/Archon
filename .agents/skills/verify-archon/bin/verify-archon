#!/usr/bin/env bash
# Verification scaffolding for this Archon checkout. Not product runtime.
# Drives launch / doctor / CLI / HTTP / cleanup against an isolated instance.
set -euo pipefail

USAGE='Usage: verify-archon [--json] [--dry-run] [--help] <command> [args]

Commands:
  launch [--port N] [--home DIR] [--with-web]
                               Start a local bun API server (isolated ARCHON_HOME).
                               --with-web also starts Vite for /console.
  doctor                       Read-only: is this instance worth driving?
  drive <feature>              Drive one mapped feature and capture evidence
  prove [feature]              launch → doctor → drive → cleanup (keeps evidence)
  cli -- <archon-args>         bun run cli with the verification environment
  http [METHOD] <path> [--body J]
                               curl the API instance under doctor
  evidence                     Print the evidence directory for this run
  cleanup [--keep-home]        Stop what launch started; never deletes evidence
  status                       Show recorded instance state
  features                     List feature-map ids the helper can drive
  help [command]               This message, or help for one command

Global flags:
  --json       Machine-readable JSON on stdout; human logs on stderr
  --dry-run    Print planned launch/cleanup actions without starting or killing
  --with-web   Also start bun Vite (packages/web) proxied at the API PORT
  -h, --help   Show help

Environment:
  ARCHON_VERIFY_TARGET     local (default) | mini
  ARCHON_VERIFY_BASE_URL   Required for mini; default local http://127.0.0.1:$PORT
  ARCHON_VERIFY_PORT       Default 13090 (avoids Mini/laptop 3090)
  ARCHON_VERIFY_WEB_PORT   Default 15173 (avoids laptop Vite 5173)
  ARCHON_VERIFY_HOME       Isolated ARCHON_HOME (default under /tmp/archon-verify)
  ARCHON_VERIFY_STATE_DIR  State file directory (default /tmp/archon-verify)
  ARCHON_VERIFY_EVIDENCE   Evidence root (default <repo>/.agents/skills/verify-archon/evidence)

Default local launch is offline: SQLite, loopback, no platform adapters, no Mini.
CLI/HTTP proofs do not need Vite. UI proofs (web-console, hitl-run-room)
require launch --with-web. hitl-run-room also needs ARCHON_E2E_FAKE_PROVIDER=1.
'

CMD_HELP_LAUNCH='Usage: verify-archon launch [--port N] [--home DIR] [--with-web] [--json] [--dry-run]

Start bun run dev:server with HOST=127.0.0.1, empty DATABASE_URL (SQLite),
ARCHON_TELEMETRY_DISABLED=1, and an isolated ARCHON_HOME. Waits until
GET /api/health returns status "ok".

--with-web also starts (from packages/web) `bun run dev --host 127.0.0.1
--port 15173 --strictPort` with PORT=<api> so Vite proxies /api to the
isolated server. Ready when GET <webUrl>/console returns the Archon SPA
shell (title Archon, #root). Required for drive web-console and
drive hitl-run-room.
Do not pass a bare `--` before Vite flags: bun then treats `--port` as its
own flag and prints `bun run` usage instead of starting Vite.

Refuses to launch when ARCHON_VERIFY_TARGET=mini (use doctor against the
remote URL instead). --dry-run prints the command and env without spawning.
'

CMD_HELP_DOCTOR='Usage: verify-archon doctor [--json]

Read-only health of the instance recorded by launch (or Mini base URL).
Requires: live PID (local), port ownership, GET /api/health status=ok,
and isolated ARCHON_HOME. Also records `archon doctor` but does not fail
the instance check when only AI binaries are missing.

When launch --with-web recorded webUrl, also requires Vite listening and
GET <webUrl>/console to be the Archon SPA shell (title + #root). API-only
launches skip those checks so prove discover-workflows stays Vite-free.
'

CMD_HELP_DRIVE='Usage: verify-archon drive <feature> [--json]

Features: diagnose-install | discover-workflows | run-deterministic-workflow
          | inspect-run | web-console | hitl-run-room

Runs the mapped recipe, writes evidence under evidence/runs/<run-id>/,
and exits non-zero if an observable assertion fails.

web-console opens Playwright (system Chrome) against the Vite origin,
asserts visible DOM (rail, runs empty state, Settings heading), and
writes screenshots + video. Requires launch --with-web. HTTP-only is
not a passing web-console proof.

hitl-run-room seeds e2e-hitl-run, runs it with the fake provider, then
opens /console/p/:projectId/r/:runId and asserts the percentage room.
Requires launch --with-web. HTTP-only is not a passing room proof.
'

CMD_HELP_PROVE='Usage: verify-archon prove [feature] [--json]

Full generator loop: launch → doctor → drive one feature → cleanup.
Cleanup does not delete evidence. Default feature: discover-workflows.
prove web-console and prove hitl-run-room imply --with-web (API + Vite).
'

CMD_HELP_CLEANUP='Usage: verify-archon cleanup [--dry-run] [--json] [--keep-home]

SIGTERM the PIDs recorded at launch (API spawn/listener, and Vite if
--with-web). Removes isolated ARCHON_HOME unless --keep-home.
Never deletes evidence. Never pkills by process name. No-op for Mini.
'

CMD_HELP_HTTP='Usage: verify-archon http [METHOD] <path> [--body JSON] [--json]

METHOD defaults to GET. Path must start with /. Hits ARCHON_VERIFY_BASE_URL
or the launched instance. Prints the response body; --json wraps status+body.
'

CMD_HELP_CLI='Usage: verify-archon cli -- <archon-args>

Runs `bun run cli -- <args>` from the repo root with ARCHON_HOME, PORT,
DATABASE_URL, and ARCHON_TELEMETRY_DISABLED matching the launched instance.
'

json_mode=0
dry_run=0
keep_home=0
with_web=0
port_override=''
home_override=''
default_web_port=${ARCHON_VERIFY_WEB_PORT:-15173}

log() { printf '%s\n' "$*" >&2; }

die() {
  local msg=$1
  local code=${2:-1}
  if [[ "$json_mode" -eq 1 ]]; then
    jq -n --arg error "$msg" --argjson ok false '{ok:$ok, error:$error}'
  else
    log "error: $msg"
  fi
  exit "$code"
}

emit_json() {
  jq -n "$@"
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
skill_dir=$(cd "$script_dir/.." && pwd)
repo_root=$(cd "$skill_dir/../../.." && pwd)

if [[ ! -f "$repo_root/package.json" ]] || ! grep -q '"name": "archon"' "$repo_root/package.json"; then
  die "could not find Archon repo root above $skill_dir"
fi

state_dir=${ARCHON_VERIFY_STATE_DIR:-/tmp/archon-verify}
state_file=$state_dir/state.json
evidence_root=${ARCHON_VERIFY_EVIDENCE:-$skill_dir/evidence}
target=${ARCHON_VERIFY_TARGET:-local}
default_port=${ARCHON_VERIFY_PORT:-13090}

ensure_tools() {
  command -v jq >/dev/null || die "jq is required"
  command -v curl >/dev/null || die "curl is required"
  command -v lsof >/dev/null || die "lsof is required"
}

export PATH="${HOME}/.bun/bin:/usr/local/bin:${PATH}"

bun_bin() {
  command -v bun || die "bun not on PATH; install from https://bun.sh"
}

load_state() {
  if [[ -f "$state_file" ]]; then
    cat "$state_file"
  else
    echo '{}'
  fi
}

save_state() {
  local body=$1
  mkdir -p "$state_dir"
  printf '%s\n' "$body" >"$state_file"
}

state_get() {
  local key=$1
  load_state | jq -r --arg k "$key" '.[$k] // empty'
}

iso_now() { date -u +'%Y-%m-%dT%H:%M:%SZ'; }

new_run_id() {
  date -u +'%Y%m%dT%H%M%SZ'"-$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
}

base_url_from_state() {
  local url
  url=$(state_get baseUrl)
  if [[ -n "${ARCHON_VERIFY_BASE_URL:-}" ]]; then
    printf '%s' "$ARCHON_VERIFY_BASE_URL"
    return
  fi
  if [[ -n "$url" ]]; then
    printf '%s' "$url"
    return
  fi
  printf 'http://127.0.0.1:%s' "${default_port}"
}

verify_env() {
  local home port
  home=$(state_get archonHome)
  port=$(state_get port)
  if [[ -z "$home" ]]; then
    home=${ARCHON_VERIFY_HOME:-}
  fi
  if [[ -z "$port" ]]; then
    port=$default_port
  fi
  # Child env: force SQLite + no adapters. Unset wins over a leaked Mini DATABASE_URL
  # because we export empty DATABASE_URL (Archon treats empty as SQLite).
  export ARCHON_HOME=$home
  export PORT=$port
  export HOST=127.0.0.1
  export DATABASE_URL=
  export ARCHON_TELEMETRY_DISABLED=1
  export ARCHON_E2E_FAKE_PROVIDER=1
  unset TELEGRAM_BOT_TOKEN SLACK_BOT_TOKEN SLACK_APP_TOKEN DISCORD_BOT_TOKEN || true
  unset BETTER_AUTH_SECRET DATABASE_URL || true
  export DATABASE_URL=
}

evidence_dir() {
  local id
  id=$(state_get runId)
  if [[ -z "$id" ]]; then
    die "no run id recorded; run launch first"
  fi
  printf '%s/runs/%s' "$evidence_root" "$id"
}

capture_file() {
  local name=$1
  printf '%s/%s' "$(evidence_dir)" "$name"
}

write_text() {
  local path=$1
  mkdir -p "$(dirname "$path")"
  cat >"$path"
}

run_captured() {
  local label=$1
  shift
  local out err code
  out=$(capture_file "${label}.stdout.txt")
  err=$(capture_file "${label}.stderr.txt")
  mkdir -p "$(evidence_dir)"
  {
    printf 'cwd=%s\ncmd=%s\n' "$PWD" "$*"
  } >"$(capture_file "${label}.cmd.txt")"
  set +e
  "$@" >"$out" 2>"$err"
  code=$?
  set -e
  printf '%s\n' "$code" >"$(capture_file "${label}.exit")"
  return "$code"
}

http_raw() {
  local method=$1
  local path=$2
  local body=${3:-}
  local url
  url=$(base_url_from_state)
  [[ "$path" == /* ]] || die "http path must start with /"
  local args=(curl -sS -w '\n%{http_code}' -X "$method" "$url$path")
  if [[ -n "$body" ]]; then
    args+=(-H 'content-type: application/json' --data "$body")
  fi
  "${args[@]}"
}

parse_help_command() {
  case "${1:-}" in
    launch) printf '%s' "$CMD_HELP_LAUNCH" ;;
    doctor) printf '%s' "$CMD_HELP_DOCTOR" ;;
    drive) printf '%s' "$CMD_HELP_DRIVE" ;;
    prove) printf '%s' "$CMD_HELP_PROVE" ;;
    cleanup) printf '%s' "$CMD_HELP_CLEANUP" ;;
    http) printf '%s' "$CMD_HELP_HTTP" ;;
    cli) printf '%s' "$CMD_HELP_CLI" ;;
    ''|help) printf '%s' "$USAGE" ;;
    *) printf '%s\n\n%s' "Unknown command: $1" "$USAGE" ;;
  esac
}

cmd_features() {
  local ids='["diagnose-install","discover-workflows","run-deterministic-workflow","inspect-run","web-console","hitl-run-room"]'
  if [[ "$json_mode" -eq 1 ]]; then
    emit_json --argjson features "$ids" '{ok:true, features:$features}'
  else
    jq -r '.[]' <<<"$ids"
  fi
}

cmd_status() {
  ensure_tools
  local st
  st=$(load_state)
  if [[ "$json_mode" -eq 1 ]]; then
    jq --argjson ok true '. + {ok:$ok}' <<<"$st"
  else
    if [[ "$st" == '{}' ]]; then
      log 'no instance recorded'
    else
      jq . <<<"$st"
    fi
  fi
}

cmd_evidence() {
  ensure_tools
  local dir id
  id=$(state_get runId)
  dir=${id:+$evidence_root/runs/$id}
  if [[ "$json_mode" -eq 1 ]]; then
    emit_json --arg evidenceDir "${dir:-}" --arg root "$evidence_root" --arg runId "$id" \
      '{ok:true, evidenceDir:$evidenceDir, evidenceRoot:$root, runId:$runId}'
  else
    printf '%s\n' "${dir:-$evidence_root}"
  fi
}

wait_health() {
  local url=$1
  local tries=60
  local i
  for ((i = 1; i <= tries; i++)); do
    if body=$(curl -sS --max-time 2 "$url/api/health" 2>/dev/null); then
      if jq -e '.status == "ok"' >/dev/null 2>&1 <<<"$body"; then
        printf '%s' "$body"
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

wait_vite() {
  local url=$1
  local tries=60
  local i body
  for ((i = 1; i <= tries; i++)); do
    if body=$(curl -sS --max-time 2 "$url/console" 2>/dev/null); then
      if [[ "$body" == *'<title>Archon</title>'* && "$body" == *'id="root"'* ]]; then
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

# Start packages/web Vite on ARCHON_VERIFY_WEB_PORT, proxying /api to the
# isolated API PORT (vite.config.ts reads process.env.PORT via loadEnv '').
start_vite() {
  local api_port web_port run_id ev_dir
  api_port=$(state_get port)
  web_port=$default_web_port
  run_id=$(state_get runId)
  ev_dir=$(state_get evidenceDir)
  [[ -n "$api_port" && -n "$run_id" ]] || die "start_vite needs launch state (port, runId)"

  local existing recorded
  existing=$(listener_pid "$web_port")
  recorded=$(state_get webListenPid)
  if [[ -n "$existing" ]]; then
    if [[ -n "$recorded" && "$existing" == "$recorded" ]]; then
      log "reusing Vite listener PID $existing on port $web_port"
      return 0
    fi
    die "web port $web_port already in use by PID $existing (not this verification instance)"
  fi

  command -v bun >/dev/null || die "bun not on PATH"
  local web_log=$state_dir/$run_id/vite.log
  mkdir -p "$(dirname "$web_log")" "${ev_dir:-/tmp}"
  (
    cd "$repo_root/packages/web"
    export PORT=$api_port
    export HOST=127.0.0.1
    # No `--` before Vite flags: bun steals `--port` and prints usage.
    bun run dev --host 127.0.0.1 --port "$web_port" --strictPort
  ) >"$web_log" 2>&1 &
  local web_spawn=$!
  sleep 0.5
  if ! pid_alive "$web_spawn"; then
    die "vite process $web_spawn exited immediately; see $web_log"
  fi
  if ! wait_vite "http://127.0.0.1:$web_port"; then
    die "vite did not serve /console on port $web_port; see $web_log"
  fi
  local web_listen
  web_listen=$(listener_pid "$web_port")
  local body
  body=$(load_state | jq \
    --arg webUrl "http://127.0.0.1:$web_port" \
    --arg webPort "$web_port" \
    --arg webSpawnPid "$web_spawn" \
    --arg webListenPid "${web_listen:-}" \
    --arg webLogFile "$web_log" \
    '. + {webUrl:$webUrl, webPort:($webPort|tonumber),
      webSpawnPid:($webSpawnPid|tonumber),
      webListenPid:(if $webListenPid=="" then null else ($webListenPid|tonumber) end),
      webLogFile:$webLogFile}')
  save_state "$body"
  if [[ -n "$ev_dir" ]]; then
    cp "$web_log" "$ev_dir/vite.log" 2>/dev/null || true
  fi
}

pid_alive() {
  local pid=$1
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

listener_pid() {
  local port=$1
  lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true
}

cmd_launch() {
  ensure_tools
  if [[ "$target" == "mini" ]]; then
    die "launch refuses Mini; set ARCHON_VERIFY_BASE_URL and run doctor"
  fi
  local port=${port_override:-$default_port}
  local run_id home_dir log_file pid_file
  run_id=$(state_get runId)
  if [[ -z "$run_id" ]]; then
    run_id=$(new_run_id)
  fi
  home_dir=${home_override:-${ARCHON_VERIFY_HOME:-$state_dir/$run_id/home}}
  log_file=$state_dir/$run_id/server.log
  pid_file=$state_dir/$run_id/server.pid
  local ev_dir=$evidence_root/runs/$run_id

  local existing
  existing=$(listener_pid "$port")
  if [[ -n "$existing" ]]; then
    local recorded
    recorded=$(state_get listenPid)
    if [[ "$existing" != "$recorded" ]]; then
      die "port $port already in use by PID $existing (not this verification instance)"
    fi
    log "reusing listener PID $existing on port $port"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    if [[ "$json_mode" -eq 1 ]]; then
      emit_json --arg port "$port" --arg home "$home_dir" --arg cmd "bun run dev:server" \
        --argjson withWeb "$with_web" --arg webPort "$default_web_port" \
        '{ok:true, dryRun:true, port:$port, archonHome:$home, command:$cmd, withWeb:($withWeb==1), webPort:$webPort}'
    else
      log "dry-run launch PORT=$port HOST=127.0.0.1 ARCHON_HOME=$home_dir"
      log "would run: bun run dev:server (cwd=$repo_root)"
      if [[ "$with_web" -eq 1 ]]; then
        log "would run: PORT=$port bun run dev --host 127.0.0.1 --port $default_web_port --strictPort (cwd=packages/web)"
      fi
    fi
    return 0
  fi

  mkdir -p "$ev_dir" "$home_dir" "$(dirname "$log_file")"

  if [[ -z "${existing:-}" ]]; then
    command -v bun >/dev/null || die "bun not on PATH"
    if [[ ! -d "$repo_root/node_modules" ]]; then
      die "node_modules missing; run bun install at $repo_root"
    fi
    (
      cd "$repo_root"
      export ARCHON_HOME=$home_dir
      export PORT=$port
      export HOST=127.0.0.1
      export DATABASE_URL=
      export ARCHON_TELEMETRY_DISABLED=1
      export ARCHON_E2E_FAKE_PROVIDER=1
      unset TELEGRAM_BOT_TOKEN SLACK_BOT_TOKEN SLACK_APP_TOKEN DISCORD_BOT_TOKEN BETTER_AUTH_SECRET
      export DATABASE_URL=
      # --watch stays under this PID group. Record bun's PID.
      bun run dev:server
    ) >"$log_file" 2>&1 &
    local spawn_pid=$!
    printf '%s\n' "$spawn_pid" >"$pid_file"
    sleep 0.5
    if ! pid_alive "$spawn_pid"; then
      die "server process $spawn_pid exited immediately; see $log_file"
    fi
    local health
    if ! health=$(wait_health "http://127.0.0.1:$port"); then
      die "server did not become healthy on port $port; see $log_file"
    fi
    local listen
    listen=$(listener_pid "$port")
    local body
    body=$(jq -n \
      --arg runId "$run_id" \
      --arg baseUrl "http://127.0.0.1:$port" \
      --arg port "$port" \
      --arg archonHome "$home_dir" \
      --arg spawnPid "$spawn_pid" \
      --arg listenPid "${listen:-}" \
      --arg logFile "$log_file" \
      --arg evidenceDir "$ev_dir" \
      --arg repoRoot "$repo_root" \
      --arg target "local" \
      --arg launchedAt "$(iso_now)" \
      --argjson health "$health" \
      '{runId:$runId, target:$target, baseUrl:$baseUrl, port:$port, archonHome:$archonHome,
        spawnPid:($spawnPid|tonumber), listenPid:(if $listenPid=="" then null else ($listenPid|tonumber) end),
        logFile:$logFile, evidenceDir:$evidenceDir, repoRoot:$repoRoot, launchedAt:$launchedAt, health:$health}')
    save_state "$body"
    printf '%s\n' "$health" >"$ev_dir/launch-health.http.json"
    cp "$log_file" "$ev_dir/server.log" 2>/dev/null || true
  else
    local health
    health=$(curl -sS "http://127.0.0.1:$port/api/health")
    local body
    body=$(load_state | jq --argjson health "$health" '. + {health:$health}')
    save_state "$body"
  fi

  if [[ "$with_web" -eq 1 ]]; then
    start_vite
  fi

  if [[ "$json_mode" -eq 1 ]]; then
    load_state | jq --argjson ok true '. + {ok:$ok}'
  else
    log "launched $(state_get baseUrl) ARCHON_HOME=$(state_get archonHome)"
    if [[ -n "$(state_get webUrl)" ]]; then
      log "web $(state_get webUrl) (Vite proxy → API $(state_get port))"
    fi
    log "evidence $(state_get evidenceDir)"
  fi
}

cmd_doctor() {
  ensure_tools
  local url home port spawn listen checks_json
  url=$(base_url_from_state)
  home=$(state_get archonHome)
  port=$(state_get port)
  spawn=$(state_get spawnPid)
  listen=$(state_get listenPid)
  local failed=0
  local checks='[]'

  add_check() {
    local name=$1 status=$2 detail=$3
    checks=$(jq --arg n "$name" --arg s "$status" --arg d "$detail" \
      '. + [{name:$n, status:$s, detail:$d}]' <<<"$checks")
    if [[ "$status" == "fail" ]]; then
      failed=1
    fi
  }

  if [[ "$target" == "mini" ]]; then
    add_check target pass "mini remote $url (will not start/stop this instance)"
  else
    if [[ -z "$home" || -z "$port" ]]; then
      add_check state fail "no launch state at $state_file"
    else
      add_check state pass "run $(state_get runId)"
    fi
    if [[ -n "$home" && "$home" == "$(printf '%s/.archon' "$HOME")" ]]; then
      add_check isolation fail "ARCHON_HOME is the operator home $home"
    elif [[ -n "$home" ]]; then
      add_check isolation pass "$home"
    fi
    if [[ "$target" != "mini" && -n "$spawn" ]]; then
      if pid_alive "$spawn"; then
        add_check spawnPid pass "PID $spawn alive"
      else
        add_check spawnPid fail "PID $spawn not running"
      fi
    fi
    if [[ -n "$port" ]]; then
      local owner
      owner=$(listener_pid "$port")
      if [[ -z "$owner" ]]; then
        add_check listener fail "nothing listening on $port"
      elif [[ -n "$listen" && "$owner" != "$listen" && "$owner" != "$spawn" ]]; then
        add_check listener fail "port $port owned by $owner, expected $listen"
      else
        add_check listener pass "PID $owner owns $port"
      fi
    fi
  fi

  local health_body health_code
  set +e
  health_body=$(curl -sS -w '\n%{http_code}' --max-time 5 "$url/api/health" 2>/dev/null)
  local curl_ec=$?
  set -e
  if [[ $curl_ec -ne 0 ]]; then
    add_check health fail "curl failed ($curl_ec) for $url/api/health"
  else
    health_code=$(printf '%s' "$health_body" | tail -n 1)
    health_body=$(printf '%s' "$health_body" | sed '$d')
    if [[ "$health_code" != "200" ]]; then
      add_check health fail "HTTP $health_code"
    elif jq -e '.status == "ok"' >/dev/null 2>&1 <<<"$health_body"; then
      add_check health pass "status=ok version=$(jq -r '.version // "unknown"' <<<"$health_body")"
    else
      add_check health fail "body status != ok"
    fi
  fi

  mkdir -p "$(evidence_dir)" 2>/dev/null || true
  if [[ -n "$(state_get runId)" ]]; then
    printf '%s\n' "${health_body:-}" >"$(capture_file doctor-health.http.json)" || true
  fi

  # Record product doctor; AI binary gaps are informational for local offline.
  local cli_doc_status=skip
  if [[ -d "$repo_root/node_modules" && "$target" == "local" && -n "$home" ]]; then
    verify_env
    local doc_out
    set +e
    doc_out=$(cd "$repo_root" && bun run cli -- doctor 2>&1)
    local doc_ec=$?
    set -e
    if [[ -n "$(state_get runId)" ]]; then
      printf '%s\n' "$doc_out" >"$(capture_file doctor.cli.txt)" || true
      printf '%s\n' "$doc_ec" >"$(capture_file doctor.cli.exit)" || true
    fi
    if echo "$doc_out" | grep -q 'Bundled defaults:'; then
      if echo "$doc_out" | grep -q '✗ Bundled defaults'; then
        add_check bundledDefaults fail "archon doctor reported bundled defaults failed"
      else
        add_check bundledDefaults pass "archon doctor loaded bundled defaults"
      fi
    fi
    if echo "$doc_out" | grep -q '✗ Database'; then
      add_check database fail "archon doctor database failed"
    elif echo "$doc_out" | grep -q 'Database:'; then
      add_check database pass "archon doctor database ok"
    fi
    cli_doc_status=$doc_ec
    add_check productDoctor pass "exit $doc_ec (AI binary fails expected offline)"
  else
    add_check productDoctor skip "cli doctor not run"
  fi

  # Vite is optional. CLI/HTTP proofs never start it. Fail only when launch
  # recorded a webUrl (prove web-console / launch --with-web).
  local web_url web_port web_spawn web_listen
  web_url=$(state_get webUrl)
  web_port=$(state_get webPort)
  web_spawn=$(state_get webSpawnPid)
  web_listen=$(state_get webListenPid)
  if [[ -z "$web_url" ]]; then
    add_check vite skip "no webUrl (API-only launch; required for web-console)"
  else
    if [[ -n "$web_spawn" ]]; then
      if pid_alive "$web_spawn"; then
        add_check viteSpawn pass "PID $web_spawn alive"
      else
        add_check viteSpawn fail "PID $web_spawn not running"
      fi
    fi
    local web_owner
    web_owner=$(listener_pid "$web_port")
    if [[ -z "$web_owner" ]]; then
      add_check viteListener fail "nothing listening on $web_port"
    elif [[ -n "$web_listen" && "$web_owner" != "$web_listen" && "$web_owner" != "$web_spawn" ]]; then
      add_check viteListener fail "port $web_port owned by $web_owner, expected $web_listen"
    else
      add_check viteListener pass "PID $web_owner owns $web_port"
    fi
    local html
    set +e
    html=$(curl -sS --max-time 5 "$web_url/console" 2>/dev/null)
    local html_ec=$?
    set -e
    if [[ $html_ec -ne 0 ]]; then
      add_check viteConsole fail "curl failed ($html_ec) for $web_url/console"
    elif [[ "$html" == *'<title>Archon</title>'* && "$html" == *'id="root"'* ]]; then
      add_check viteConsole pass "$web_url/console is the Archon SPA shell"
    else
      add_check viteConsole fail "$web_url/console is not the Archon SPA (title/root missing)"
    fi
  fi

  local ok=true
  if [[ "$failed" -ne 0 ]]; then ok=false; fi
  if [[ "$json_mode" -eq 1 ]]; then
    jq -n --argjson ok "$ok" --argjson checks "$checks" --arg baseUrl "$url" \
      --arg archonHome "$home" --arg productDoctorExit "${cli_doc_status:-}" \
      '{ok:$ok, baseUrl:$baseUrl, archonHome:$archonHome, productDoctorExit:$productDoctorExit, checks:$checks}'
  else
    jq -r '.[] | "[\(.status)] \(.name): \(.detail)"' <<<"$checks"
    if [[ "$ok" != "true" ]]; then
      exit 1
    fi
  fi
  if [[ "$ok" != "true" ]]; then
    exit 1
  fi
}

cmd_cli() {
  ensure_tools
  if [[ $# -eq 0 ]]; then
    die "cli requires args after --"
  fi
  local home
  home=$(state_get archonHome)
  if [[ -z "$home" && "$target" == "local" ]]; then
    die "no ARCHON_HOME recorded; launch first"
  fi
  verify_env
  cd "$repo_root"
  bun run cli -- --cwd "$repo_root" "$@"
}

cmd_http() {
  ensure_tools
  local method=GET path='' body=''
  if [[ $# -eq 0 ]]; then
    die "http requires a path"
  fi
  if [[ "$1" =~ ^(GET|POST|PUT|PATCH|DELETE)$ ]]; then
    method=$1
    shift
  fi
  path=${1:-}
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --body)
        body=${2:-}
        shift 2 || die "--body needs a value"
        ;;
      *) die "unknown http flag: $1" ;;
    esac
  done
  [[ -n "$path" ]] || die "http requires a path"
  local raw code payload
  set +e
  raw=$(http_raw "$method" "$path" "$body")
  local ec=$?
  set -e
  [[ $ec -eq 0 ]] || die "curl failed for $method $path"
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  if [[ "$json_mode" -eq 1 ]]; then
    jq -n --arg method "$method" --arg path "$path" --argjson status "$code" --arg body "$payload" \
      '{ok:($status>=200 and $status<300), method:$method, path:$path, status:$status, body:(try ($body|fromjson) catch $body)}'
  else
    printf '%s\n' "$payload"
    if [[ "$code" -lt 200 || "$code" -ge 300 ]]; then
      exit 1
    fi
  fi
}

assert_jq() {
  local file=$1
  local expr=$2
  local msg=$3
  if ! jq -e "$expr" "$file" >/dev/null; then
    die "$msg"
  fi
}

drive_diagnose_install() {
  local ev
  ev=$(evidence_dir)
  cmd_doctor >/dev/null
  verify_env
  local raw code payload
  raw=$(http_raw GET /api/health)
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/health.http.json"
  [[ "$code" == "200" ]] || die "GET /api/health HTTP $code"
  assert_jq "$ev/health.http.json" '.status == "ok"' "health status is not ok"
  (cd "$repo_root" && bun run cli -- --cwd "$repo_root" doctor >"$ev/doctor.cli.txt" 2>&1) || true
  jq -n --arg feature diagnose-install --arg evidenceDir "$ev" \
    '{feature:$feature, evidenceDir:$evidenceDir, ok:true}' >"$ev/summary.json"
}

drive_discover_workflows() {
  local ev repo
  ev=$(evidence_dir)
  repo=$repo_root
  verify_env
  cd "$repo"
  bun run cli -- --cwd "$repo" workflow list --json >"$ev/workflow-list.cli.json" 2>"$ev/workflow-list.cli.stderr"
  assert_jq "$ev/workflow-list.cli.json" \
    '[.workflows[] | select(.name == "e2e-deterministic")] | length == 1' \
    "CLI list missing e2e-deterministic"
  bun run cli -- --cwd "$repo" validate workflows e2e-deterministic --json \
    >"$ev/validate-e2e-deterministic.cli.json" 2>"$ev/validate-e2e-deterministic.cli.stderr" \
    || die "validate workflows e2e-deterministic failed"
  assert_jq "$ev/validate-e2e-deterministic.cli.json" \
    '.summary.errors == 0' \
    "e2e-deterministic validation reported errors"
  local raw code payload
  raw=$(http_raw GET /api/workflows)
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/workflows-bundled.http.json"
  [[ "$code" == "200" ]] || die "GET /api/workflows HTTP $code"
  assert_jq "$ev/workflows-bundled.http.json" '.workflows | length > 0' "bundled catalog empty"
  raw=$(http_raw POST /api/codebases "{\"path\":\"$repo\"}")
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/codebase-register.http.json"
  [[ "$code" == "200" || "$code" == "201" ]] || die "POST /api/codebases HTTP $code"
  assert_jq "$ev/codebase-register.http.json" '.id != null and .id != ""' \
    "register response missing codebase id"
  if ! jq -e --arg p "$repo" '.default_cwd == $p' "$ev/codebase-register.http.json" >/dev/null; then
    die "registered default_cwd is not $repo"
  fi
  # cwd query must be encoded
  local encoded
  encoded=$(jq -rn --arg v "$repo" '$v|@uri')
  raw=$(http_raw GET "/api/workflows?cwd=$encoded")
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/workflows-project.http.json"
  [[ "$code" == "200" ]] || die "GET /api/workflows?cwd= HTTP $code"
  assert_jq "$ev/workflows-project.http.json" \
    '[.workflows[] | select(.workflow.name == "e2e-deterministic")] | length >= 1' \
    "project catalog missing e2e-deterministic"
  jq '{count:(.workflows|length), names:[.workflows[].name]}' \
    "$ev/workflow-list.cli.json" >"$ev/workflow-list.cli.names.json"
  jq '{count:(.workflows|length), names:[.workflows[].workflow.name]}' \
    "$ev/workflows-bundled.http.json" >"$ev/workflows-bundled.http.names.json"
  jq '{count:(.workflows|length), names:[.workflows[] | {name:.workflow.name, source}]}' \
    "$ev/workflows-project.http.json" >"$ev/workflows-project.http.names.json"
  jq '{id, name, default_cwd, kind}' "$ev/codebase-register.http.json" \
    >"$ev/codebase-register.meta.json"
  jq -n --arg feature discover-workflows --arg evidenceDir "$ev" --arg repo "$repo" \
    '{feature:$feature, evidenceDir:$evidenceDir, repo:$repo, ok:true}' >"$ev/summary.json"
}

drive_run_deterministic() {
  local ev
  ev=$(evidence_dir)
  verify_env
  cd "$repo_root"
  bun run cli -- --cwd "$repo_root" workflow runs --json >"$ev/runs-before.cli.json" 2>"$ev/runs-before.cli.stderr" || true
  bun run cli -- --cwd "$repo_root" workflow run e2e-deterministic --dry-run --json \
    >"$ev/dry-run.cli.json" 2>"$ev/dry-run.cli.stderr" \
    || die "dry-run e2e-deterministic failed"
  bun run cli -- --cwd "$repo_root" workflow runs --json >"$ev/runs-after-dry-run.cli.json" 2>"$ev/runs-after-dry-run.cli.stderr" || true
  jq -n --arg feature run-deterministic-workflow --arg evidenceDir "$ev" \
    '{feature:$feature, evidenceDir:$evidenceDir, ok:true, note:"dry-run does not create a run"}' \
    >"$ev/summary.json"
}

drive_inspect_run() {
  local ev
  ev=$(evidence_dir)
  verify_env
  cd "$repo_root"
  bun run cli -- --cwd "$repo_root" workflow runs --json >"$ev/runs.cli.json" 2>"$ev/runs.cli.stderr"
  local raw code payload
  raw=$(http_raw GET /api/workflows/runs)
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/runs.http.json"
  [[ "$code" == "200" ]] || die "GET /api/workflows/runs HTTP $code"
  local count
  count=$(jq 'if type=="array" then length elif .runs then (.runs|length) else 0 end' "$ev/runs.cli.json")
  if [[ "$count" -lt 1 ]]; then
    die "inspect-run unreachable: no runs in isolated home (drive run-deterministic-workflow first)"
  fi
  jq -n --arg feature inspect-run --arg evidenceDir "$ev" \
    '{feature:$feature, evidenceDir:$evidenceDir, ok:true}' >"$ev/summary.json"
}

require_system_chrome() {
  if [[ -d '/Applications/Google Chrome.app' ]]; then
    return 0
  fi
  command -v google-chrome >/dev/null || command -v google-chrome-stable >/dev/null \
    || die "system Chrome not found (harness uses Playwright channel: chrome)"
}

ensure_playwright_harness() {
  local harness=$1
  if [[ ! -d "$harness/node_modules/playwright" ]]; then
    log "installing Playwright harness deps in $harness"
    (cd "$harness" && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 bun install) \
      || die "bun install failed in $harness"
  fi
  require_system_chrome
  if [[ ! -x "${HOME}/.cache/ms-playwright/ffmpeg-1011/ffmpeg-linux" ]] \
    && [[ ! -x "${HOME}/.cache/ms-playwright/ffmpeg-1011/ffmpeg-mac" ]]; then
    (cd "$harness" && bunx playwright install ffmpeg) \
      || log "playwright ffmpeg install skipped; screenshots still required"
  fi
}

drive_hitl_run_room() {
  local ev web_url home repo fixture harness run_id
  ev=$(evidence_dir)
  web_url=$(state_get webUrl)
  home=$(state_get archonHome)
  repo=$repo_root
  [[ -n "$web_url" ]] || die "hitl-run-room requires launch --with-web (no webUrl in state)"
  [[ -n "$home" ]] || die "hitl-run-room requires isolated ARCHON_HOME from launch"
  fixture=$repo/e2e/fixtures/workflows/e2e-hitl-run.yaml
  [[ -f "$fixture" ]] || die "missing HITL fixture $fixture"

  verify_env
  mkdir -p "$home/workflows"
  cp "$fixture" "$home/workflows/e2e-hitl-run.yaml"

  local raw code payload
  raw=$(http_raw GET /api/auth/status)
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/auth-status.http.json"
  [[ "$code" == "200" ]] || die "GET /api/auth/status HTTP $code"
  assert_jq "$ev/auth-status.http.json" '.enabled == false' \
    "solo verification expects GET /api/auth/status enabled=false"

  raw=$(http_raw POST /api/codebases "{\"path\":\"$repo\"}")
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/codebase-register.http.json"
  [[ "$code" == "200" || "$code" == "201" ]] || die "POST /api/codebases HTTP $code"
  assert_jq "$ev/codebase-register.http.json" '.id != null and .id != ""' \
    "register response missing codebase id"

  cd "$repo"
  set +e
  bun run cli -- --cwd "$repo" workflow run e2e-hitl-run --no-worktree --json \
    >"$ev/hitl-run.cli.stdout.txt" 2>"$ev/hitl-run.cli.stderr.txt"
  local run_ec=$?
  set -e
  printf '%s\n' "$run_ec" >"$ev/hitl-run.cli.exit"
  if [[ "$run_ec" -ne 0 ]]; then
    die "workflow run e2e-hitl-run failed (exit $run_ec); see hitl-run.cli.stderr.txt"
  fi
  local envelope
  envelope=$(grep 'workflowRunRef' "$ev/hitl-run.cli.stdout.txt" | tail -n 1) \
    || die "no workflowRunRef in e2e-hitl-run CLI output"
  printf '%s\n' "$envelope" >"$ev/hitl-run.cli.json"
  run_id=$(jq -r '.workflowRunRef.runId // empty' "$ev/hitl-run.cli.json")
  [[ -n "$run_id" && "$run_id" != "null" ]] || die "e2e-hitl-run envelope missing runId"
  printf '%s\n' "$run_id" >"$ev/hitl-run-id.txt"

  raw=$(http_raw GET "/api/workflows/runs/$run_id")
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/run-detail.http.json"
  [[ "$code" == "200" ]] || die "GET /api/workflows/runs/$run_id HTTP $code"
  assert_jq "$ev/run-detail.http.json" '.run.codebase_id != null and .run.codebase_id != ""' \
    "run-detail missing codebase_id"

  harness=$skill_dir/harness
  ensure_playwright_harness "$harness"
  export ARCHON_VERIFY_WEB_URL=$web_url
  export ARCHON_VERIFY_API_URL
  ARCHON_VERIFY_API_URL=$(state_get baseUrl)
  export ARCHON_VERIFY_EVIDENCE_DIR=$ev
  export ARCHON_VERIFY_RUN_ID=$run_id
  (cd "$harness" && bun run drive-hitl-run-room) || die "Playwright drive-hitl-run-room failed"

  [[ -f "$ev/hitl-room-open.png" ]] || die "missing screenshot hitl-room-open.png"
  [[ -f "$ev/hitl-room-closed.png" ]] || die "missing screenshot hitl-room-closed.png"
  [[ -f "$ev/hitl-room-deeplink.png" ]] || die "missing screenshot hitl-room-deeplink.png"
  [[ -f "$ev/ui-assertions.json" ]] || die "missing ui-assertions.json"
  assert_jq "$ev/ui-assertions.json" '.ok == true' "ui-assertions.ok is not true"
  assert_jq "$ev/ui-assertions.json" \
    '[.assertions[] | select(.id=="room-open" and .ok==true)] | length == 1' \
    "room-open assertion missing"
  assert_jq "$ev/ui-assertions.json" \
    '[.assertions[] | select(.id=="room-history" and .ok==true)] | length == 1' \
    "room-history assertion missing"
  assert_jq "$ev/ui-assertions.json" \
    '[.assertions[] | select(.id=="room-deeplink" and .ok==true)] | length == 1' \
    "room-deeplink assertion missing"

  jq -n --arg feature hitl-run-room --arg evidenceDir "$ev" --arg webUrl "$web_url" \
    --arg runId "$run_id" --slurpfile ui "$ev/ui-assertions.json" \
    '{feature:$feature, evidenceDir:$evidenceDir, webUrl:$webUrl, runId:$runId, ok:true, ui:$ui[0]}' \
    >"$ev/summary.json"
}

drive_web_console() {
  local ev web_url harness
  ev=$(evidence_dir)
  web_url=$(state_get webUrl)
  [[ -n "$web_url" ]] || die "web-console requires launch --with-web (no webUrl in state)"

  local raw code payload
  raw=$(http_raw GET /api/auth/status)
  code=$(printf '%s' "$raw" | tail -n 1)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/auth-status.http.json"
  [[ "$code" == "200" ]] || die "GET /api/auth/status HTTP $code"
  assert_jq "$ev/auth-status.http.json" '.enabled == false' \
    "solo verification expects GET /api/auth/status enabled=false (login would block the console)"
  raw=$(http_raw GET /api/health)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/health.http.json"
  raw=$(http_raw GET /api/workflows)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/workflows.http.json"
  raw=$(http_raw GET /api/codebases)
  payload=$(printf '%s' "$raw" | sed '$d')
  printf '%s\n' "$payload" >"$ev/codebases.http.json"

  harness=$skill_dir/harness
  ensure_playwright_harness "$harness"

  export ARCHON_VERIFY_WEB_URL=$web_url
  export ARCHON_VERIFY_EVIDENCE_DIR=$ev
  (cd "$harness" && bun run drive-console) || die "Playwright drive-console failed"

  [[ -f "$ev/console-runs.png" ]] || die "missing screenshot console-runs.png"
  [[ -f "$ev/console-runs-all.png" ]] || die "missing screenshot console-runs-all.png"
  [[ -f "$ev/console-settings.png" ]] || die "missing screenshot console-settings.png"
  [[ -f "$ev/ui-assertions.json" ]] || die "missing ui-assertions.json"
  assert_jq "$ev/ui-assertions.json" '.ok == true' "ui-assertions.ok is not true"
  assert_jq "$ev/ui-assertions.json" \
    '[.assertions[] | select(.id=="console-rail" and .ok==true)] | length == 1' \
    "rail assertion missing"
  assert_jq "$ev/ui-assertions.json" \
    '[.assertions[] | select(.id=="console-settings" and .ok==true)] | length == 1' \
    "settings route assertion missing"

  jq -n --arg feature web-console --arg evidenceDir "$ev" --arg webUrl "$web_url" \
    --slurpfile ui "$ev/ui-assertions.json" \
    '{feature:$feature, evidenceDir:$evidenceDir, webUrl:$webUrl, ok:true, ui:$ui[0]}' \
    >"$ev/summary.json"
}

cmd_drive() {
  ensure_tools
  local feature=${1:-}
  [[ -n "$feature" ]] || die "drive requires a feature id"
  [[ -n "$(state_get runId)" ]] || die "launch first so evidence/run state exists"
  mkdir -p "$(evidence_dir)"
  case "$feature" in
    diagnose-install) drive_diagnose_install ;;
    discover-workflows) drive_discover_workflows ;;
    run-deterministic-workflow) drive_run_deterministic ;;
    inspect-run) drive_inspect_run ;;
    web-console) drive_web_console ;;
    hitl-run-room) drive_hitl_run_room ;;
    *) die "unknown feature: $feature (run: verify-archon features)" ;;
  esac
  if [[ "$json_mode" -eq 1 ]]; then
    jq --argjson ok true '.' "$(evidence_dir)/summary.json"
  else
    log "drove $feature"
    log "evidence $(evidence_dir)"
    jq . "$(evidence_dir)/summary.json"
  fi
}

cmd_cleanup() {
  ensure_tools
  if [[ "$target" == "mini" ]]; then
    if [[ "$json_mode" -eq 1 ]]; then
      emit_json '{ok:true, skipped:true, reason:"mini target: never stop remote PM2"}'
    else
      log 'mini target: cleanup is a no-op (will not stop remote)'
    fi
    return 0
  fi
  local spawn listen home ev port web_spawn web_listen web_port
  spawn=$(state_get spawnPid)
  listen=$(state_get listenPid)
  home=$(state_get archonHome)
  ev=$(state_get evidenceDir)
  port=$(state_get port)
  web_spawn=$(state_get webSpawnPid)
  web_listen=$(state_get webListenPid)
  web_port=$(state_get webPort)
  if [[ "$dry_run" -eq 1 ]]; then
    if [[ "$json_mode" -eq 1 ]]; then
      emit_json --arg spawn "$spawn" --arg listen "$listen" --arg webSpawn "$web_spawn" \
        --arg webListen "$web_listen" --arg home "$home" --arg ev "$ev" \
        '{ok:true, dryRun:true,
          wouldSignalPids:[$spawn,$listen,$webSpawn,$webListen] | map(select(. != "" and . != "null")) | map(tonumber),
          wouldRemoveHome:$home, wouldPreserveEvidence:$ev}'
    else
      log "dry-run cleanup would signal API PID $spawn then $listen"
      if [[ -n "$web_spawn" ]]; then
        log "dry-run cleanup would signal Vite PID $web_spawn then $web_listen"
      fi
      log "would remove ARCHON_HOME $home"
      log "would keep evidence $ev"
    fi
    return 0
  fi
  local signaled=()
  stop_pid() {
    local pid=$1
    [[ -n "$pid" && "$pid" != "null" ]] || return 0
    if pid_alive "$pid"; then
      kill -TERM "$pid" 2>/dev/null || true
      signaled+=("$pid")
      local i
      for ((i = 0; i < 20; i++)); do
        pid_alive "$pid" || break
        sleep 0.25
      done
      if pid_alive "$pid"; then
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
  }
  stop_pid "$web_spawn"
  if [[ -n "$web_port" ]]; then
    local web_owner
    web_owner=$(listener_pid "$web_port")
    if [[ -n "$web_owner" && ( "$web_owner" == "$web_listen" || "$web_owner" == "$web_spawn" ) ]]; then
      stop_pid "$web_owner"
    fi
  fi
  stop_pid "$spawn"
  if [[ -n "$port" ]]; then
    local owner
    owner=$(listener_pid "$port")
    if [[ -n "$owner" && ( "$owner" == "$listen" || "$owner" == "$spawn" ) ]]; then
      stop_pid "$owner"
    fi
  fi
  if [[ "$keep_home" -eq 0 && -n "$home" && -d "$home" ]]; then
    case "$home" in
      /tmp/archon-verify/*|"$state_dir"/*)
        rm -rf "$home"
        ;;
      *)
        log "refusing to delete ARCHON_HOME outside /tmp/archon-verify: $home"
        ;;
    esac
  fi
  # Confirm evidence survived
  if [[ -n "$ev" && ! -d "$ev" ]]; then
    die "cleanup destroyed evidence at $ev"
  fi
  if [[ "$json_mode" -eq 1 ]]; then
    emit_json --arg evidenceDir "$ev" --argjson signaled "$(printf '%s\n' "${signaled[@]:-}" | jq -R . | jq -s 'map(select(length>0))')" \
      '{ok:true, signaledPids:$signaled, evidenceDir:$evidenceDir, evidenceSurvived:true}'
  else
    log "cleanup complete; evidence still at $ev"
  fi
  # Drop instance pointers but keep runId/evidenceDir so `evidence` still works
  if [[ -f "$state_file" ]]; then
    load_state | jq '.spawnPid=null | .listenPid=null | .webSpawnPid=null | .webListenPid=null
      | .cleanedAt=now | .cleanedAt|=(strftime("%Y-%m-%dT%H:%M:%SZ"))' >"$state_file.tmp"
    mv "$state_file.tmp" "$state_file"
  fi
}

cmd_prove() {
  local feature=${1:-discover-workflows}
  if [[ "$feature" == "web-console" || "$feature" == "hitl-run-room" ]]; then
    with_web=1
  fi
  cmd_launch
  cmd_doctor >/dev/null
  cmd_drive "$feature"
  local ev
  ev=$(state_get evidenceDir)
  cmd_cleanup
  if [[ ! -d "$ev" ]]; then
    die "evidence missing after cleanup: $ev"
  fi
  # Per-feature last-proof so discover-workflows and web-console coexist.
  # Keep PROOF.md (hand-written) across re-proves; refresh everything else.
  local last_dir=$evidence_root/last-proof/$feature
  local proof_keep=''
  if [[ -f "$last_dir/PROOF.md" ]]; then
    proof_keep=$(mktemp)
    cp -a "$last_dir/PROOF.md" "$proof_keep"
  fi
  rm -rf "$last_dir"
  mkdir -p "$last_dir"
  if [[ -n "$proof_keep" ]]; then
    mv "$proof_keep" "$last_dir/PROOF.md"
  fi
  # Commit-sized subset: skip full workflow-definition dumps (they are megabytes).
  local f
  local copies=(
    summary.json launch-health.http.json doctor-health.http.json doctor.cli.txt
    doctor.cli.exit
  )
  if [[ "$feature" == "web-console" ]]; then
    copies+=(ui-assertions.json console-runs.png console-runs-all.png console-settings.png)
  elif [[ "$feature" == "hitl-run-room" ]]; then
    copies+=(
      ui-assertions.json hitl-run.cli.json hitl-run-id.txt
      hitl-room-open.png hitl-room-closed.png hitl-room-deeplink.png
    )
  else
    copies+=(
      validate-e2e-deterministic.cli.json codebase-register.meta.json
      workflow-list.cli.names.json workflows-bundled.http.names.json
      workflows-project.http.names.json
    )
  fi
  for f in "${copies[@]}"; do
    if [[ -f "$ev/$f" ]]; then
      cp -a "$ev/$f" "$last_dir/$f"
    fi
  done
  if [[ ( "$feature" == "web-console" || "$feature" == "hitl-run-room" ) && -d "$ev/video" ]]; then
    mkdir -p "$last_dir/video"
    local vid
    for vid in "$ev"/video/*.{webm,mp4}; do
      if [[ -f "$vid" ]]; then
        cp -a "$vid" "$last_dir/video/"
      fi
    done
  fi
  if [[ "$json_mode" -eq 1 ]]; then
    emit_json --arg feature "$feature" --arg evidenceDir "$ev" --arg lastProof "$last_dir" \
      '{ok:true, feature:$feature, evidenceDir:$evidenceDir, lastProof:$lastProof}'
  else
    log "proved $feature"
    log "evidence $ev"
    log "copied to $last_dir"
  fi
}

# --- argv ---
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) json_mode=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --keep-home) keep_home=1; shift ;;
    --port)
      port_override=${2:-}
      shift 2 || die "--port needs a value"
      ;;
    --home)
      home_override=${2:-}
      shift 2 || die "--home needs a value"
      ;;
    --with-web)
      with_web=1
      shift
      ;;
    -h|--help) parse_help_command "${2:-}"; exit 0 ;;
    --) shift; args+=("$@"); break ;;
    -*)
      # allow --body to reach http after command parse; stash for now
      args+=("$1")
      shift
      ;;
    *) args+=("$1"); shift ;;
  esac
done

command=${args[0]:-help}
set -- "${args[@]:1}"

case "$command" in
  help) parse_help_command "${1:-}"; exit 0 ;;
  launch)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --with-web) with_web=1; shift ;;
        --json) json_mode=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        --port)
          port_override=${2:-}
          shift 2 || die "--port needs a value"
          ;;
        --home)
          home_override=${2:-}
          shift 2 || die "--home needs a value"
          ;;
        *) die "unknown launch args: $1" ;;
      esac
    done
    cmd_launch
    ;;
  doctor) cmd_doctor ;;
  drive) cmd_drive "${1:-}" ;;
  prove) cmd_prove "${1:-}" ;;
  cli)
    if [[ "${1:-}" == "--" ]]; then shift; fi
    cmd_cli "$@"
    ;;
  http) cmd_http "$@" ;;
  evidence) cmd_evidence ;;
  cleanup) cmd_cleanup ;;
  status) cmd_status ;;
  features) cmd_features ;;
  *) die "unknown command: $command (try verify-archon --help)" ;;
esac

{
  "version": 1,
  "id": "web-console",
  "description": "Console project navigation, runs shell and Settings.",
  "impact_paths": [
    "packages/web/src/experiments/console/**",
    "packages/web/src/index*",
    "packages/web/src/main*",
    "e2e/ui/console-shell.spec.ts"
  ],
  "behaviors": [
    {
      "id": "console.navigation",
      "description": "Console loads its navigation and runs view.",
      "priority": "P1",
      "scenarios": ["console.shell"]
    },
    {
      "id": "console.settings",
      "description": "Settings opens through the console.",
      "priority": "P1",
      "scenarios": ["console.settings"]
    }
  ],
  "scenarios": [
    {
      "id": "console.shell",
      "runner": {
        "kind": "playwright",
        "file": "ui/console-shell.spec.ts"
      },
      "proof_obligations": ["browser-action", "final-ui", "screenshot"]
    },
    {
      "id": "console.settings",
      "runner": {
        "kind": "playwright",
        "file": "ui/console-shell.spec.ts"
      },
      "proof_obligations": ["browser-action", "final-ui", "screenshot"]
    }
  ]
}

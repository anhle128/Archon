# Runtime proof dirs are local. last-proof/<feature>/ keeps a slim committed subset.
runs/
last-select/
*.pid
state.json
# Full workflow-definition dumps are megabytes; never commit them.
*.http.json
!last-proof/**/launch-health.http.json
!last-proof/**/doctor-health.http.json
last-proof/**/workflows-*.http.json
last-proof/**/workflow-list.cli.json
last-proof/**/codebase-register.http.json
last-proof/**/server.log
last-proof/**/vite.log
